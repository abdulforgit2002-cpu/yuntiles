function FloatingWhatsApp() {
  return (
    <WhatsAppLink
      className="floating-whatsapp"
      aria-label="Chat with YUNTILES DECOR on WhatsApp"
      message="Hello YUNTILES DECOR, I would like to make an enquiry."
    >
      <FaWhatsapp />
      <span>Chat with us</span>
    </WhatsAppLink>
  );
}

function GoogleTranslate() {
  useEffect(() => {
    window.gtranslateSettings = {
      default_language: 'en',
      languages: ['en', 'sw', 'ar'],
      wrapper_selector: '.gtranslate_wrapper',
      switcher_horizontal_position: 'inline',
      switcher_vertical_position: 'top',
      float_switcher_open_direction: 'bottom',
    };

    const existingScript = document.getElementById('gtranslate-script');

    if (!existingScript) {
      const script = document.createElement('script');
      script.id = 'gtranslate-script';
      script.src =
        'https://cdn.gtranslate.net/widgets/latest/float.js';
      script.defer = true;
      document.body.appendChild(script);
    }
  }, []);

  return <div className="gtranslate_wrapper" />;
}

function App() {
  return (
    <>
      <Navbar />
      <main>
        <Hero />
        <Intro />
        <Services />
        <Projects />
        <WhyChooseUs />
        <Contact />
      </main>
      <Footer />
      <FloatingWhatsApp />
      <GoogleTranslate />
    </>
  );
}

export default App;
